      "description": "Nút mặc định 48px; trong ActionArea lên 56px.",
      "html": "<button class=\"ds-btn\">Gửi cọc</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;max-width:100%;border:1px solid transparent;border-radius:14px;font-family:'Be Vietnam Pro',system-ui,sans-serif;font-size:16px;line-height:1.5;font-weight:600;text-align:center;white-space:normal;cursor:pointer;transition:background-color 150ms,color 150ms,border-color 150ms;min-height:48px;padding:8px 16px;background:var(--primary,#30254b);color:var(--primary-foreground,#fff);}.ds-btn:hover:not(:disabled){background:var(--primary-hover,#241b3a);}.ds-btn:focus-visible{outline:2px solid var(--ring,#6e5597);outline-offset:3px;}.ds-btn:disabled{opacity:.5;pointer-events:none}@media(prefers-reduced-motion:reduce){.ds-btn{transition-duration:.01ms}}"
    },
