FEE_RECIPIENT_ADDRESS=
# true = hạn chót tính bằng phút để demo; false = hạn thật
DEMO_TIMEOUTS=true

# Ví bồi thẩm được thêm ngay lúc deploy, cách nhau bằng dấu phẩy (không dấu cách)
