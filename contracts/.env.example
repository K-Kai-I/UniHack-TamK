# Ví deploy riêng, chỉ dùng cho test. KHÔNG dùng ví cá nhân.
DEPLOYER_PRIVATE_KEY=
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Địa chỉ (không phải key) của ví ký con dấu AI và ví nhận phí
