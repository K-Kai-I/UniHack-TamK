# Chép thành .env.local rồi điền. KHÔNG commit .env.local.
# Biến có tiền tố NEXT_PUBLIC_ trình duyệt đọc được: không đặt bí mật vào đó.

# Privy (dashboard.privy.io)
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Chuỗi
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
VND_PER_TOKEN=25000
FEE_BPS=1000

# Ví riêng cho test, chỉ Khải giữ
AI_SIGNER_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=
KEEPER_SECRET=

# Database và kho ảnh (Supabase). DATABASE_URL lấy ở nút Connect > Transaction pooler (cổng 6543).
# STORAGE_KEY là Secret key (sb_secret_...) ở Project Settings > API Keys. Bucket "photos" để private.
# Bỏ trống cả 3 khi chạy local: server tự dùng database trong máy (PGlite), ảnh lưu vào database.
DATABASE_URL=
SUPABASE_URL=
STORAGE_KEY=

# AVAX ví keeper gửi cho ví mới ở /faucet (chỉ khi ví đó gần hết gas)
FAUCET_AVAX=0.005

# Chỉ dùng khi test API ở máy: 1 = nhận header x-dev-wallet thay cho token Privy. Vercel luôn bỏ qua.
AUTH_DEV_BYPASS=

# Mô hình AI (bạn làm AI điền)
AI_MODEL=mock
AI_API_KEY=

# Bản thật: AI_MODEL=gemini-3.1-flash-lite; AI_API_KEY là khóa Google AI Studio.
# OpenAI chỉ giải thích báo cáo chữ; hai khóa này KHÁC NHAU.
OPENAI_MODEL=gpt-6-luna
OPENAI_API_KEY=

# Privy trả gas hộ (1 = bật). Chỉ có tác dụng với ví Google (embedded) và khi đã bật
# "Fee sponsorship" cho Avalanche Fuji trong Privy dashboard. Để trống = người dùng tự trả AVAX test.
NEXT_PUBLIC_SPONSOR_GAS=

# Frontend dùng API giả cho Đăng phòng (uploads, listings) cho tới khi API của Khải chạy. Đặt 0 để gọi API thật.
NEXT_PUBLIC_MOCK_API=
