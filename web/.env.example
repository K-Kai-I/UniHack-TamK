# Chép thành .env.local rồi điền. KHÔNG commit .env.local.
# Biến có tiền tố NEXT_PUBLIC_ trình duyệt đọc được: không đặt bí mật vào đó.

# Privy (dashboard.privy.io)
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Chuỗi
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
VND_PER_TOKEN=25000
FEE_BPS=1000

# Ví riêng cho test, chỉ Khải giữ
AI_SIGNER_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=
KEEPER_SECRET=

# Database và kho ảnh
DATABASE_URL=
STORAGE_KEY=

# Mô hình AI (bạn làm AI điền)
AI_MODEL=mock
AI_API_KEY=
